secret.h
secrets.h
config/secret.h

firmware/esp32_s3_eye_alarm/main/secrets.hpp
firmware/esp32_s3_eye_alarm/main/secrets.h

*.pem
*.key
*.crt
*.p12

.env
.env.*

config.json
raspberry/config.json


