# ============================================================
# Python
# ============================================================

__pycache__/
*.pyc
*.pyo
*.pyd

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/


# ============================================================
# Jupyter
# ============================================================

.ipynb_checkpoints/


# ============================================================
# Dataset - do not push large image files
# ============================================================

dataset/raw/*
dataset/processed/*
dataset/rejected/*
dataset/incoming/*
dataset/dark_candidates/*
dataset/splits/*
dataset/training/*

# Keep dataset directory structure
!dataset/raw/.gitkeep
!dataset/processed/.gitkeep
!dataset/rejected/.gitkeep
!dataset/incoming/.gitkeep
!dataset/dark_candidates/.gitkeep
!dataset/splits/.gitkeep
!dataset/training/.gitkeep


# ============================================================
# Models - do not push heavy training files
# ============================================================

*.pth
*.pt
*.ckpt
*.onnx
*.tflite
*.h5

# Keep the deployable ESP-DL model required by the firmware
!firmware/esp32_s3_eye_alarm/main/model/
!firmware/esp32_s3_eye_alarm/main/model/mcunet_int8.espdl


# ============================================================
# Results generated during experiments
# ============================================================

results/plots/*.png
results/confusion_matrices/*.png
results/metrics/*.csv

results/**/*.pt
results/**/*.pth
results/**/*.ckpt
results/**/*.onnx
results/**/*.tflite
results/**/*.h5
results/**/*.espdl
results/**/*.info
results/**/*.json


